{
  "name": "community-scam-map-backend",
  "version": "1.0.0",
  "description": "Community Scam Map – backend API (Node.js 24, Express 5, TypeScript)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.cjs",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" \"src/db/**/*.js\" \"tests/**/*.ts\" \"tests/**/*.js\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrations/run.js",
    "license:issue": "tsx scripts/issue-license.ts",
    "test:db:prepare": "tsx scripts/prepare-test-db.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seeds/run.js",
    "test:db": "vitest run tests/database.test.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.2",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
